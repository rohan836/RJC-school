# Copy this file to .env. Never commit .env.
PORT=3000
HOST=0.0.0.0
# Optional override when the PC has more than one network adapter:
# LAN_IP=192.168.1.100
# Optional Chrome/Edge executable override for offline PDF generation:
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Optional HTTPS URL shown in the single phone QR (e.g. https://<name>.trycloudflare.com).
# Leave blank to auto-detect a running cloudflared tunnel (see Start_Public_Tunnel.bat)
# or a tunnel URL saved in Admin → Branding & Portal; otherwise the LAN address is used.
PUBLIC_PORTAL_URL=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
# Public HTTPS hostname allowed only for /webhook (reverse proxy must restrict other paths).
PUBLIC_WEBHOOK_URL=
